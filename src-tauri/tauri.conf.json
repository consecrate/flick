{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Flick",
  "version": "0.1.0",
  "identifier": "app.flick.desktop",
  "build": {
    "frontendDist": "loading",
    "beforeBuildCommand": "npm run build && npm run build:server"
  },
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Gamified AI flashcards",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/flick-server"],
    "resources": { "../dist/": "ui/" },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
